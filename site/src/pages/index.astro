---
import Base from '../layouts/Base.astro';
---
<Base>
  <section class="hero">
    <h1>Find the right tool for your Claude Code</h1>
    <p>Search reusable plugins, skills, agents, commands, and MCP servers — installable into any project.</p>
  </section>

  <section aria-label="Catalog search">
    <div class="search-controls">
      <input id="q" type="search" placeholder='Try "code review", "generate docs", "deploy"…' autofocus />
      <select id="type-filter" aria-label="Filter by type">
        <option value="">All types</option>
        <option value="plugin">Plugins</option>
        <option value="skill">Skills</option>
        <option value="agent">Agents</option>
        <option value="command">Commands</option>
        <option value="mcp-server">MCP servers</option>
      </select>
      <select id="category-filter" aria-label="Filter by category">
        <option value="">All categories</option>
      </select>
    </div>
    <p id="result-count" role="status"></p>
    <div id="results" class="card-grid"></div>
    <div id="empty" class="empty-state" hidden>
      <div data-empty="catalog" hidden>
        <h2>The catalog is being bootstrapped</h2>
        <p>
          No plugins have been published yet. Want to publish the first one?
          Read the <a href="https://github.com/SyukPublic/ai-dev-toolkit/blob/main/CONTRIBUTING.md">contributing guide</a>.
        </p>
      </div>
      <div data-empty="results" hidden>
        <h2>No matches</h2>
        <p>Try different keywords, or clear the type and category filters.</p>
      </div>
    </div>
  </section>

  <script>
    import MiniSearch from 'minisearch';
    import synonymGroups from '../data/synonyms.json';

    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    const escapeHtml = (s) =>
      String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

    const qEl = document.getElementById('q');
    const typeEl = document.getElementById('type-filter');
    const catEl = document.getElementById('category-filter');
    const resultsEl = document.getElementById('results');
    const countEl = document.getElementById('result-count');
    const emptyEl = document.getElementById('empty');

    const data = await (await fetch(`${base}/api/index.json`)).json();
    const docs = data.artifacts;
    const byId = new Map(docs.map((d) => [d.id, d]));

    for (const c of [...new Set(docs.map((d) => d.category).filter(Boolean))].sort()) {
      const opt = document.createElement('option');
      opt.value = c;
      opt.textContent = c;
      catEl.appendChild(opt);
    }

    const mini = new MiniSearch({
      idField: 'id',
      fields: ['name', 'displayName', 'keywords', 'description', 'body', 'category'],
      extractField: (doc, field) => (Array.isArray(doc[field]) ? doc[field].join(' ') : (doc[field] ?? '')),
    });
    mini.addAll(docs);

    const searchOptions = {
      boost: { name: 3, displayName: 3, keywords: 2.5, description: 2, category: 1.5, body: 1 },
      prefix: true,
      fuzzy: 0.2,
    };

    const expandSynonyms = (query) =>
      query
        .trim()
        .toLowerCase()
        .split(/\s+/)
        .flatMap((term) => {
          const group = synonymGroups.find((g) => g.includes(term));
          return group ? [...new Set([term, ...group])] : [term];
        })
        .join(' ');

    function search(query) {
      if (!query.trim()) return docs;
      let hits = mini.search(query, { ...searchOptions, combineWith: 'AND' });
      if (hits.length < 3) {
        const expanded = mini.search(expandSynonyms(query), { ...searchOptions, combineWith: 'OR' });
        const seen = new Set(hits.map((h) => h.id));
        hits = [...hits, ...expanded.filter((h) => !seen.has(h.id))];
      }
      return hits.map((h) => byId.get(h.id));
    }

    const dirByType = { skill: 'skills', agent: 'agents', command: 'commands' };
    const href = (a) =>
      a.type === 'plugin'
        ? `${base}/plugins/${a.name}/`
        : dirByType[a.type]
          ? `${base}/plugins/${a.plugin}/${dirByType[a.type]}/${a.name}/`
          : `${base}/plugins/${a.plugin}/`;

    const card = (a) => `<article class="card">
      <div class="card-top">
        <span class="badge type-${a.type}">${a.type.replace('-', ' ')}</span>
        ${a.version ? `<span class="version">v${escapeHtml(a.version)}</span>` : ''}
      </div>
      <h3><a href="${href(a)}">${escapeHtml(a.displayName)}</a></h3>
      <p>${escapeHtml(a.description)}</p>
      <div class="card-meta">
        ${a.type !== 'plugin' ? `<span>in ${escapeHtml(a.plugin)}</span>` : ''}
        ${a.category ? `<span>${escapeHtml(a.category)}</span>` : ''}
      </div>
      <div class="chips">${(a.keywords ?? []).slice(0, 4).map((k) => `<span class="chip">${escapeHtml(k)}</span>`).join('')}</div>
      <button class="copy" data-copy="${escapeHtml(a.installCommand)}" title="Copy install command">Copy install</button>
    </article>`;

    function render() {
      const query = qEl.value;
      let results = search(query);
      if (typeEl.value) results = results.filter((a) => a.type === typeEl.value);
      if (catEl.value) results = results.filter((a) => a.category === catEl.value);

      const params = new URLSearchParams();
      if (query.trim()) params.set('q', query.trim());
      if (typeEl.value) params.set('type', typeEl.value);
      if (catEl.value) params.set('category', catEl.value);
      const qs = params.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);

      resultsEl.innerHTML = results.map(card).join('');
      countEl.textContent = docs.length ? `${results.length} of ${docs.length} artifacts` : '';

      const mode = docs.length === 0 ? 'catalog' : results.length === 0 ? 'results' : null;
      emptyEl.hidden = mode === null;
      emptyEl.querySelector('[data-empty="catalog"]').hidden = mode !== 'catalog';
      emptyEl.querySelector('[data-empty="results"]').hidden = mode !== 'results';
    }

    const params = new URLSearchParams(location.search);
    qEl.value = params.get('q') ?? '';
    typeEl.value = params.get('type') ?? '';
    catEl.value = params.get('category') ?? '';
    qEl.addEventListener('input', render);
    typeEl.addEventListener('change', render);
    catEl.addEventListener('change', render);
    render();
  </script>
</Base>
